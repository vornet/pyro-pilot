<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PyroPilot.App.ViewModels"
             xmlns:core="using:PyroPilot.Core.Model"
             mc:Ignorable="d" d:DesignWidth="1220" d:DesignHeight="900"
             x:Class="PyroPilot.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#FF7A00" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="300,*" Margin="24">
        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,24,0">
            <TextBlock Text="Firework Library" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Keep a photo and real-world video with each product." FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
            <Button Content="+ New Firework" Command="{Binding NewCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Classes="accent" />
            <ListBox ItemsSource="{Binding Fireworks}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:FireworkDefinition">
                        <Grid ColumnDefinitions="12,*,Auto" Margin="0,4">
                            <Border Grid.Column="0" Background="{Binding ColorHex}" CornerRadius="6" Height="36" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DurationMs, StringFormat='{}{0} ms'}"
                                       VerticalAlignment="Center" Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="8" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" MaxWidth="900">
                    <Grid ColumnDefinitions="*,280" ColumnSpacing="18">
                        <Border Grid.Column="0" Height="400" Background="#05070C" CornerRadius="8" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding EditPreviewImage}" Stretch="Uniform" Margin="8"
                                       IsVisible="{Binding HasPreviewImage}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                            IsVisible="{Binding !HasPreviewImage}">
                                    <TextBlock Text="No image attached" FontSize="18" HorizontalAlignment="Center" Opacity="0.7" />
                                    <TextBlock Text="Add a product photo or a frame from the real effect."
                                               FontSize="11" Opacity="0.55" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Text="Reference media" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Use a photo for quick recognition and a YouTube link to see the actual performance."
                                       FontSize="11" Opacity="0.65" TextWrapping="Wrap" />
                            <Button Content="Choose Image..." Click="OnChooseImageClick" Classes="accent"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <TextBlock Text="{Binding EditPreviewImageFileName}" FontSize="11" Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Content="Remove Image" Command="{Binding RemoveImageCommand}"
                                    IsEnabled="{Binding HasPreviewImage}" HorizontalAlignment="Stretch" />

                            <Border Height="1" Background="#FFFFFF22" Margin="0,8" />
                            <TextBlock Text="YouTube video URL" Classes="label" />
                            <TextBox Text="{Binding EditVideoUrl}" PlaceholderText="https://www.youtube.com/watch?v=..." />
                            <Button Content="Open Video" Command="{Binding OpenVideoCommand}"
                                    IsEnabled="{Binding HasVideoUrl}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding MediaStatus}" FontSize="11" Foreground="#FBBF24" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#FFFFFF22" Margin="0,8" />
                    <TextBlock Text="Name" Classes="label" />
                    <TextBox Text="{Binding EditName}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Category" Classes="label" />
                            <ComboBox ItemsSource="{Binding CommonCategories}" SelectedItem="{Binding EditCategory}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Duration (ms)" Classes="label" />
                            <NumericUpDown Value="{Binding EditDurationMs}" Minimum="100" Maximum="600000"
                                           Increment="100" FormatString="0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Timeline color" Classes="label" />
                    <TextBox Text="{Binding EditColorHex}" />
                    <TextBlock Text="Description" Classes="label" />
                    <TextBox Text="{Binding EditDescription}" AcceptsReturn="True" Height="90"
                             TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}"
                                IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" Classes="danger" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
