<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PyroPilot.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1220" d:DesignHeight="900"
             x:Class="PyroPilot.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

    <UserControl.Styles>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,10" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#FF7A00" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.port">
            <Setter Property="Background" Value="#2A303C" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style Selector="Button.port.armed">
            <Setter Property="Background" Value="#C2410C" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,20">
            <TextBlock Text="Devices" FontSize="22" FontWeight="Bold" />
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="8" Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox PlaceholderText="Nickname" Text="{Binding NewNickname}" Width="160" />
                    <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding NewProtocol}" Width="120" />
                    <TextBox PlaceholderText="Host / IP" Text="{Binding NewHost}" Width="160" />
                    <NumericUpDown Value="{Binding NewPort}" Minimum="1" Maximum="65535" FormatString="0" Width="110" />
                    <NumericUpDown Value="{Binding NewPortCount}" Minimum="1" Maximum="60" FormatString="0" Width="90" />
                    <Button Content="Add Device" Command="{Binding AddDeviceCommand}" Classes="accent" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRowViewModel">
                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8" />
                                    <Button Grid.Column="2" Content="Connect" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0" Classes="accent" />
                                    <Button Grid.Column="2" Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" Margin="0,0,8,0" />
                                    <Button Grid.Column="3" Content="Remove" Click="OnRemoveDeviceClick" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Ports}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PortButtonViewModel">
                                            <Button Classes="port" Classes.armed="{Binding IsArmed}" Click="OnPortButtonClick">
                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ArmedPort, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                        <Run Text="Armed: port" /> <Run Text="{Binding ArmedPort.Number}" FontWeight="Bold" />
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="FIRE" Command="{Binding FireArmedPortCommand}" Classes="danger" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
